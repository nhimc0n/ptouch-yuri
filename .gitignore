# will have compiled files and executables
debug
target

# nix build result symlinks
/result
/result-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Contains mutation testing data
**/mutants.out*/

# IDE config files (the E850 protocol skill under .claude/skills is tracked)
.claude/*
!.claude/skills/
.DS_Store
.cursor
.tasks
.vscode

# Python packaging checks
__pycache__/

# Raw Wireshark captures stay local; extracted jobs live in fixtures/jobs
fixtures/captures/*.pcapng
settings-app/src-tauri/target
settings-app/src-tauri/gen
